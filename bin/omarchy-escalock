#!/bin/bash

set -euo pipefail

readonly helper=/usr/local/libexec/omarchy-escalock-helper
readonly uninstaller=/usr/local/libexec/omarchy-escalock-maint-uninstall
readonly pkexec=/usr/bin/pkexec
readonly sudo=/usr/bin/sudo
readonly omarchy=/usr/share/omarchy/bin/omarchy
readonly plugin_id=andrewbacon.escalock

usage() {
  echo "Usage: omarchy-escalock {version|status|on|off|toggle|uninstall}" >&2
  exit 2
}

helper_status() {
  "$helper" status
}

status() {
  case "$(helper_status)" in
    enabled) echo off ;;
    disabled) echo on ;;
    inconsistent) echo inconsistent ;;
    *)
      echo "Could not determine Secure Mode state." >&2
      return 1
      ;;
  esac
}

change_state() {
  local operation=$1
  local secure_state=$2
  local result
  local rc

  if [[ $(helper_status) == inconsistent ]]; then
    echo "Secure Mode is inconsistent; no transition was attempted." >&2
    echo "Review current sudo policy, then run the plugin checkout's setup.sh --rebaseline." >&2
    return 1
  fi

  set +e
  result=$("$pkexec" "$helper" "$operation")
  rc=$?
  set -e
  case $rc in
    0)
      if [[ $operation == enable && $result == enabled ]] ||
         [[ $operation == disable && $result == disabled ]]; then
        printf '%s\n' "$secure_state"
      else
        echo "Secure Mode transition returned an unexpected state: $result" >&2
        return 1
      fi
      ;;
    126)
      echo "Authentication was canceled; Secure Mode was not changed." >&2
      return 126
      ;;
    127)
      echo "Authorization was denied or unavailable; Secure Mode was not changed." >&2
      return 127
      ;;
    *)
      echo "Secure Mode transition failed; inspect the helper error above." >&2
      return "$rc"
      ;;
  esac
}

uninstall_escalock() {
  local target_user

  (( EUID != 0 )) || {
    echo "Run uninstall as the configured desktop user, not with sudo." >&2
    return 1
  }
  target_user=$(/usr/bin/id -un)
  case "$(helper_status)" in
    enabled) ;;
    disabled)
      echo "Restoring Administrator Mode before uninstall..." >&2
      change_state enable off >/dev/null
      ;;
    *)
      echo "Secure Mode is inconsistent; preserving the recovery mechanism." >&2
      echo "Review current sudo policy, then run the plugin checkout's setup.sh --rebaseline." >&2
      return 1
      ;;
  esac
  [[ $(helper_status) == enabled ]] || {
    echo "Administrator Mode could not be verified ON." >&2
    return 1
  }
  [[ -x $uninstaller ]] || {
    echo "The installed uninstall tool is missing; preserving system files." >&2
    return 1
  }

  "$omarchy" plugin disable "$plugin_id" 2>/dev/null || true
  "$sudo" -- "$uninstaller" --user "$target_user"
  if "$omarchy" plugin remove "$plugin_id" --yes; then
    echo "Removed the EscaLock plugin checkout."
  else
    echo "System components were removed; remove the plugin checkout with:" >&2
    echo "  omarchy plugin remove $plugin_id --yes" >&2
  fi
}

(( $# == 1 )) || usage
case "$1" in
  version)
    "$helper" version
    ;;
  status)
    status
    ;;
  on)
    change_state disable on
    ;;
  off)
    change_state enable off
    ;;
  toggle)
    case "$(helper_status)" in
      enabled) change_state disable on ;;
      disabled) change_state enable off ;;
      *)
        echo "Secure Mode is inconsistent; refusing to guess a transition." >&2
        echo "Review current sudo policy, then run the plugin checkout's setup.sh --rebaseline." >&2
        exit 1
        ;;
    esac
    ;;
  uninstall)
    uninstall_escalock
    ;;
  *)
    usage
    ;;
esac
