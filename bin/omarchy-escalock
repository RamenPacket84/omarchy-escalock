#!/bin/bash

set -euo pipefail

readonly helper=/usr/local/libexec/omarchy-escalock-helper
readonly uninstaller=/usr/local/libexec/omarchy-escalock-maint-uninstall
readonly pkexec=/usr/bin/pkexec
readonly sudo=/usr/bin/sudo
readonly omarchy=/usr/share/omarchy/bin/omarchy
readonly git=/usr/bin/git
readonly plugin_id=andrewbacon.escalock
readonly plugin_dir="${HOME:-}/.config/omarchy/plugins/$plugin_id"
readonly onboarding="$plugin_dir/bin/omarchy-escalock-onboard"

usage() {
  echo "Usage: omarchy-escalock {version|status|on|off|toggle|update|uninstall}" >&2
  exit 2
}

interactive() {
  [[ -t 0 && -t 1 ]]
}

helper_status() {
  "$helper" status
}

status() {
  case "$(helper_status)" in
    enabled) echo off ;;
    disabled) echo on ;;
    inconsistent) echo inconsistent ;;
    *)
      echo "Could not determine Secure Mode state." >&2
      return 1
      ;;
  esac
}

change_state() {
  local operation=$1
  local secure_state=$2
  local result
  local rc

  if [[ $(helper_status) == inconsistent ]]; then
    echo "Secure Mode is inconsistent; no transition was attempted." >&2
    echo "Review the administrator changes from the widget, or run 'omarchy-escalock update'." >&2
    return 1
  fi

  set +e
  result=$("$pkexec" "$helper" "$operation")
  rc=$?
  set -e
  case $rc in
    0)
      if [[ $operation == enable && $result == enabled ]] ||
         [[ $operation == disable && $result == disabled ]]; then
        printf '%s\n' "$secure_state"
      else
        echo "Secure Mode transition returned an unexpected state: $result" >&2
        return 1
      fi
      ;;
    126)
      echo "Authentication was canceled; Secure Mode was not changed." >&2
      return 126
      ;;
    127)
      echo "Authorization was denied or unavailable; Secure Mode was not changed." >&2
      return 127
      ;;
    *)
      echo "Secure Mode transition failed; inspect the helper error above." >&2
      return "$rc"
      ;;
  esac
}

validate_update_checkout() {
  local git_root

  [[ ${HOME:-} == /* && ${HOME:-} != / ]] || {
    echo "Could not locate the desktop user's home directory safely." >&2
    return 1
  }
  [[ -d $plugin_dir && ! -L $plugin_dir ]] || {
    echo "The EscaLock plugin checkout is missing or unsafe: $plugin_dir" >&2
    return 1
  }
  [[ -x $onboarding && -f $onboarding && ! -L $onboarding ]] || {
    echo "The EscaLock update launcher is missing or unsafe: $onboarding" >&2
    return 1
  }
  git_root=$($git -C "$plugin_dir" rev-parse --show-toplevel 2>/dev/null) || {
    echo "The EscaLock plugin is not a Git-managed checkout." >&2
    return 1
  }
  [[ $git_root == "$plugin_dir" ]] || {
    echo "The EscaLock plugin checkout is not its Git repository root." >&2
    return 1
  }
}

update_escalock() {
  local before_commit after_commit update_rc
  local -a finish_args=(--run-finish-update)

  (( EUID != 0 )) || {
    echo "Run update as the configured desktop user, not with sudo." >&2
    return 1
  }
  interactive || {
    echo "EscaLock update requires an interactive terminal." >&2
    return 1
  }
  validate_update_checkout
  before_commit=$($git -C "$plugin_dir" rev-parse HEAD) || return 1

  echo "Checking GitHub for an EscaLock update..."
  set +e
  "$omarchy" plugin update "$plugin_id"
  update_rc=$?
  set -e

  validate_update_checkout
  after_commit=$($git -C "$plugin_dir" rev-parse HEAD) || return 1
  if (( update_rc != 0 )) && [[ $after_commit == "$before_commit" ]]; then
    echo "The EscaLock plugin checkout was not updated." >&2
    return "$update_rc"
  fi
  if (( update_rc != 0 )); then
    echo "The checkout was updated, but Omarchy could not refresh the running widget." >&2
    echo "Continuing with verified EscaLock system setup." >&2
  fi
  if [[ $after_commit != "$before_commit" ]]; then
    finish_args+=(--source-changed)
  fi

  exec "$onboarding" "${finish_args[@]}"
}

uninstall_escalock() {
  local target_user

  (( EUID != 0 )) || {
    echo "Run uninstall as the configured desktop user, not with sudo." >&2
    return 1
  }
  target_user=$(/usr/bin/id -un)
  case "$(helper_status)" in
    enabled) ;;
    disabled)
      echo "Restoring Administrator Mode before uninstall..." >&2
      change_state enable off >/dev/null
      ;;
    *)
      echo "Secure Mode is inconsistent; preserving the recovery mechanism." >&2
      echo "Review the administrator changes from the widget, or run 'omarchy-escalock update'." >&2
      return 1
      ;;
  esac
  [[ $(helper_status) == enabled ]] || {
    echo "Administrator Mode could not be verified ON." >&2
    return 1
  }
  [[ -x $uninstaller ]] || {
    echo "The installed uninstall tool is missing; preserving system files." >&2
    return 1
  }

  "$omarchy" plugin disable "$plugin_id" 2>/dev/null || true
  "$sudo" -- "$uninstaller" --user "$target_user"
  if "$omarchy" plugin remove "$plugin_id" --yes; then
    echo "Removed the EscaLock plugin checkout."
  else
    echo "System components were removed; remove the plugin checkout with:" >&2
    echo "  omarchy plugin remove $plugin_id --yes" >&2
  fi
}

(( $# == 1 )) || usage
case "$1" in
  version)
    "$helper" version
    ;;
  status)
    status
    ;;
  on)
    change_state disable on
    ;;
  off)
    change_state enable off
    ;;
  toggle)
    case "$(helper_status)" in
      enabled) change_state disable on ;;
      disabled) change_state enable off ;;
      *)
        echo "Secure Mode is inconsistent; refusing to guess a transition." >&2
        echo "Review the administrator changes from the widget, or run 'omarchy-escalock update'." >&2
        exit 1
        ;;
    esac
    ;;
  update)
    update_escalock
    ;;
  uninstall)
    uninstall_escalock
    ;;
  *)
    usage
    ;;
esac
