#!/bin/bash

set -euo pipefail
umask 077
export LC_ALL=C

readonly helper=/usr/local/libexec/omarchy-escalock-helper
readonly maintainer=/usr/local/libexec/omarchy-escalock-maintain
readonly cli=/usr/local/bin/omarchy-escalock
readonly config_dir=/etc/omarchy-escalock
readonly sudoers_dir=/etc/sudoers.d
readonly sudoers_main=/etc/sudoers
readonly sudo_conf=/etc/sudo.conf
readonly wheel_grant=/etc/sudoers.d/00-omarchy-wheel
readonly policy_file=/usr/share/polkit-1/actions/com.github.andrewbacon.omarchy-escalock.policy
readonly rule_file=/etc/polkit-1/rules.d/00-00-omarchy-escalock.rules
readonly rule_basename=00-00-omarchy-escalock.rules
readonly legacy_recovery_rule=/etc/polkit-1/rules.d/05-omarchy-escalock-recovery.rules
readonly legacy_off_rule=/etc/polkit-1/rules.d/10-omarchy-escalock-off.rules
readonly legacy_manage_rule=/etc/polkit-1/rules.d/20-omarchy-escalock-manage.rules
readonly backup_root=/var/backups/omarchy-escalock

system_paths=(
  "$helper"
  "$maintainer"
  "$cli"
  "$policy_file"
  "$rule_file"
  "$legacy_recovery_rule"
  "$legacy_off_rule"
  "$legacy_manage_rule"
)

fail() {
  echo "omarchy-escalock-maintain: $*" >&2
  exit 1
}

usage() {
  echo "Usage: omarchy-escalock-maintain {install|check} --stage DIR --user USER --commit SHA --digest SHA256" >&2
  echo "       omarchy-escalock-maintain uninstall --user USER" >&2
  exit 2
}

[[ $EUID == 0 ]] || fail "this maintenance command must run as root"

operation=${1:-}
[[ -n $operation ]] || usage
shift

stage=
target_user=
source_commit=
payload_digest=
while (( $# > 0 )); do
  case "$1" in
    --stage)
      (( $# >= 2 )) || usage
      stage=${2:-}
      shift 2
      ;;
    --user)
      (( $# >= 2 )) || usage
      target_user=${2:-}
      shift 2
      ;;
    --commit)
      (( $# >= 2 )) || usage
      source_commit=${2:-}
      shift 2
      ;;
    --digest)
      (( $# >= 2 )) || usage
      payload_digest=${2:-}
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done

[[ $target_user =~ ^[a-z_][a-z0-9_-]*$ ]] || fail "invalid target username"
passwd_entry=$(/usr/bin/getent passwd "$target_user") || fail "target account does not exist"
IFS=: read -r account _ target_uid target_gid _ _ _ <<<"$passwd_entry"
[[ $account == "$target_user" && $target_uid =~ ^[0-9]+$ && $target_gid =~ ^[0-9]+$ ]] ||
  fail "target account lookup mismatch"
(( target_uid >= 1000 && target_uid != 65534 )) || fail "target UID must be a normal local user"

grant="$sudoers_dir/00_$target_user"
grant_mode=dedicated
expected_rule="$target_user ALL=(ALL) ALL"
expected_wheel_rule='%wheel ALL=(ALL:ALL) ALL'
expected_managed_wheel_rule="%wheel, !$target_user ALL=(ALL:ALL) ALL"
transaction_paths=("${system_paths[@]}" "$grant" "$wheel_grant")

config_grant_mode() {
  local configured_mode

  configured_mode=$(/usr/bin/sed -n 's/^GRANT_MODE=//p' "$config_dir/config")
  case "$configured_mode" in
    "" | dedicated) echo dedicated ;;
    omarchy-wheel) echo omarchy-wheel ;;
    *) return 1 ;;
  esac
}

config_belongs_to_target() {
  local configured_mode expected legacy_expected

  [[ -f $config_dir/config && ! -L $config_dir/config ]] || return 1
  [[ $(/usr/bin/stat -c '%u:%g:%a' "$config_dir/config") == 0:0:600 ]] || return 1
  configured_mode=$(config_grant_mode) || return 1
  expected=$'TARGET_USER='"$target_user"$'\nTARGET_UID='"$target_uid"$'\nGRANT_MODE='"$configured_mode"
  [[ $(<"$config_dir/config") == "$expected" ]] && return 0
  legacy_expected=$'TARGET_USER='"$target_user"$'\nTARGET_UID='"$target_uid"
  [[ $configured_mode == dedicated && $(<"$config_dir/config") == "$legacy_expected" ]]
}

grant_is_exact() {
  [[ -f $grant && ! -L $grant ]] || return 1
  [[ $(/usr/bin/stat -c '%u:%g:%a' "$grant") == 0:0:440 ]] || return 1
  [[ $(/usr/bin/wc -l < "$grant") == 1 && $(<"$grant") == "$expected_rule" ]]
}

wheel_grant_is_exact() {
  local expected=$1

  [[ -f $wheel_grant && ! -L $wheel_grant ]] || return 1
  [[ $(/usr/bin/stat -c '%u:%g:%a' "$wheel_grant") == 0:0:440 ]] || return 1
  [[ $(/usr/bin/wc -l < "$wheel_grant") == 1 && $(<"$wheel_grant") == "$expected" ]]
}

fresh_wheel_migration=false

select_grant_mode() {
  if [[ -e $config_dir || -L $config_dir ]]; then
    [[ -d $config_dir && ! -L $config_dir ]] || fail "existing configuration path is unsafe"
    [[ $(/usr/bin/stat -c '%u:%g:%a' "$config_dir") == 0:0:700 ]] ||
      fail "existing configuration directory has unsafe ownership or permissions"
    config_belongs_to_target || fail "existing EscaLock configuration belongs to another account or is invalid"
    grant_mode=$(config_grant_mode) || fail "existing EscaLock grant mode is invalid"
  elif grant_is_exact; then
    grant_mode=dedicated
  elif [[ ! -e $grant && ! -L $grant ]] && wheel_grant_is_exact "$expected_wheel_rule"; then
    /usr/bin/id -nG "$target_user" | /usr/bin/grep -qw wheel ||
      fail "target user is not a member of Omarchy's wheel group: $target_user"
    grant_mode=omarchy-wheel
    fresh_wheel_migration=true
  else
    fail "no supported general sudo grant was found; expected $grant or $wheel_grant"
  fi

  if [[ $grant_mode == omarchy-wheel ]]; then
    expected_rule="$target_user ALL=(ALL:ALL) ALL"
    if [[ $fresh_wheel_migration == false ]]; then
      grant_is_exact || fail "managed per-user sudo grant is missing, unsafe, or modified: $grant"
      wheel_grant_is_exact "$expected_managed_wheel_rule" ||
        fail "managed Omarchy wheel grant is missing, unsafe, or modified: $wheel_grant"
    else
      echo "Detected Omarchy shared wheel grant; only $target_user will be isolated for Secure Mode."
    fi
  else
    expected_rule="$target_user ALL=(ALL) ALL"
    grant_is_exact || fail "expected dedicated sudo grant is missing, unsafe, or modified: $grant"
  fi
}

check_sudo_policy_backend() {
  local metadata mode entry symbol module
  local configured_plugins=()
  local policy_count=0

  [[ -e $sudo_conf ]] || return 0
  [[ -f $sudo_conf && ! -L $sudo_conf ]] || fail "unsafe sudo configuration path: $sudo_conf"
  metadata=$(/usr/bin/stat -c '%u:%g:%a' "$sudo_conf")
  [[ $metadata == 0:*:* ]] || fail "$sudo_conf must be root-owned"
  mode=${metadata##*:}
  (( (8#$mode & 0022) == 0 )) || fail "$sudo_conf must not be group- or world-writable"
  mapfile -t configured_plugins < <(
    /usr/bin/awk '
      /^[[:space:]]*#/ { next }
      /^[[:space:]]*Plugin[[:space:]]+/ { print $2 "|" $3 }
    ' "$sudo_conf"
  )
  for entry in "${configured_plugins[@]}"; do
    symbol=${entry%%|*}
    module=${entry#*|}
    [[ ${module##*/} == sudoers.so ]] ||
      fail "unsupported sudo plugin configuration: $symbol $module"
    case "$symbol" in
      sudoers_policy) (( policy_count += 1 )) ;;
      sudoers_io | sudoers_audit) ;;
      *) fail "unsupported sudo plugin symbol: $symbol" ;;
    esac
  done
  if (( ${#configured_plugins[@]} > 0 )); then
    (( policy_count == 1 )) || fail "$sudo_conf does not select exactly one sudoers policy plugin"
  fi
}

check_rule_precedence() {
  local directory path basename metadata mode

  for directory in /etc/polkit-1/rules.d /usr/share/polkit-1/rules.d; do
    [[ -d $directory && ! -L $directory ]] || fail "unsafe or missing Polkit rule directory: $directory"
    metadata=$(/usr/bin/stat -c '%u:%g:%a' "$directory")
    [[ $metadata == 0:*:* ]] || fail "Polkit rule directory must be root-owned: $directory"
    mode=${metadata##*:}
    (( (8#$mode & 0022) == 0 )) || fail "Polkit rule directory is group- or world-writable: $directory"
    while IFS= read -r -d '' path; do
      basename=${path##*/}
      if [[ $basename < $rule_basename ]] ||
         [[ $directory == /usr/share/polkit-1/rules.d && $basename == "$rule_basename" ]]; then
        fail "Polkit rule $path sorts before EscaLock and can preempt its security decisions"
      fi
    done < <(/usr/bin/find "$directory" -mindepth 1 -maxdepth 1 -name '*.rules' -print0)
  done
}

check_stage() {
  local relative metadata_version helper_version
  local required=(
    build/omarchy-escalock-helper
    bin/omarchy-escalock
    bin/omarchy-escalock-maintain
    manifest.json
    polkit/00-00-omarchy-escalock-on.rules.in
    polkit/00-00-omarchy-escalock-off.rules.in
    polkit/com.github.andrewbacon.omarchy-escalock.policy
  )

  [[ $stage == /* && -d $stage && ! -L $stage ]] || fail "the verified staging directory is unsafe"
  [[ $(/usr/bin/stat -c '%u:%g:%a' "$stage") == 0:0:700 ]] ||
    fail "the verified staging directory must be root:root mode 0700"
  for relative in "${required[@]}"; do
    [[ -f $stage/$relative && ! -L $stage/$relative ]] || fail "staged payload is missing $relative"
    [[ $(/usr/bin/stat -c '%u:%g' "$stage/$relative") == 0:0 ]] ||
      fail "staged payload member is not root-owned: $relative"
  done
  [[ $source_commit =~ ^[0-9a-f]{40,64}$ ]] || fail "invalid source commit"
  [[ $payload_digest =~ ^[0-9a-f]{64}$ ]] || fail "invalid payload digest"
  metadata_version=$(/usr/bin/jq -er '.version' "$stage/manifest.json") || fail "invalid staged manifest"
  helper_version=$("$stage/build/omarchy-escalock-helper" version) || fail "staged helper cannot report its version"
  [[ $metadata_version == "$helper_version" ]] || fail "manifest/helper version mismatch"
  if /usr/bin/strings "$stage/build/omarchy-escalock-helper" |
      /usr/bin/grep 'OMARCHY_ESCALOCK_TEST_' >/dev/null; then
    fail "refusing to install a helper containing test-only hooks"
  fi
  /usr/bin/xmllint --noout "$stage/polkit/com.github.andrewbacon.omarchy-escalock.policy"
}

render_templates() {
  local destination=$1

  /usr/bin/install -d -o root -g root -m 0700 "$destination"
  /usr/bin/sed "s/@@TARGET_USER@@/$target_user/g" \
    "$stage/polkit/00-00-omarchy-escalock-on.rules.in" > "$destination/rule.on"
  /usr/bin/sed "s/@@TARGET_USER@@/$target_user/g" \
    "$stage/polkit/00-00-omarchy-escalock-off.rules.in" > "$destination/rule.off"
  /usr/bin/chown root:root "$destination/rule.on" "$destination/rule.off"
  /usr/bin/chmod 0644 "$destination/rule.on" "$destination/rule.off"
}

render_sudo_templates() {
  local destination=$1

  /usr/bin/install -d -o root -g root -m 0700 "$destination"
  /usr/bin/printf '%s\n' "$expected_rule" > "$destination/sudoers.template"
  /usr/bin/chown root:root "$destination/sudoers.template"
  /usr/bin/chmod 0440 "$destination/sudoers.template"
  if [[ $grant_mode == omarchy-wheel ]]; then
    /usr/bin/printf '%s\n' "$expected_wheel_rule" > "$destination/omarchy-wheel.original"
    /usr/bin/printf '%s\n' "$expected_managed_wheel_rule" > "$destination/omarchy-wheel.managed"
    /usr/bin/chown root:root "$destination/omarchy-wheel.original" "$destination/omarchy-wheel.managed"
    /usr/bin/chmod 0440 "$destination/omarchy-wheel.original" "$destination/omarchy-wheel.managed"
  fi
}

create_policy_snapshots() {
  local destination=$1
  local filter="user=$target_user"
  local managed_count wheel_count general_count command executable basename delegation_kind

  /usr/bin/cvtsudoers -f JSON -e -M -m "$filter" "$sudoers_main" |
    /usr/bin/jq -S . > "$destination/sudo-policy.current.json"

  if [[ $grant_mode == dedicated ]]; then
    /usr/bin/cp -- "$destination/sudo-policy.current.json" "$destination/sudo-policy.enabled.json"
  elif [[ $fresh_wheel_migration == true ]]; then
    wheel_count=$(/usr/bin/jq '
      [
        .User_Specs[]?
        | select(.User_List == [{"usergroup": "wheel"}])
        | select(.Host_List == [{"hostname": "ALL"}])
        | .Cmnd_Specs[]?
        | select((.runasusers // []) == [{"username": "ALL"}])
        | select((.runasgroups // []) == [{"usergroup": "ALL"}])
        | select(.Commands == [{"command": "ALL"}])
      ] | length
    ' "$destination/sudo-policy.current.json")
    [[ $wheel_count == 1 ]] ||
      fail "the effective sudo policy does not contain exactly one Omarchy wheel grant"
    /usr/bin/jq -S --arg user "$target_user" '
      def controlled_wheel:
        (.User_List == [{"usergroup": "wheel"}]) and
        (.Host_List == [{"hostname": "ALL"}]) and
        (.Cmnd_Specs | length == 1) and
        (.Cmnd_Specs[0].runasusers // [] == [{"username": "ALL"}]) and
        (.Cmnd_Specs[0].runasgroups // [] == [{"usergroup": "ALL"}]) and
        (.Cmnd_Specs[0].Commands == [{"command": "ALL"}]);
      .User_Specs |= [
        .[]
        | if controlled_wheel then
            (.User_List += [{"username": $user, "negated": true}]),
            (.User_List = [{"username": $user}])
          else . end
      ]
    ' "$destination/sudo-policy.current.json" > "$destination/sudo-policy.enabled.json"
  else
    /usr/bin/cp -- "$destination/sudo-policy.current.json" "$destination/sudo-policy.enabled.json"
  fi

  managed_count=$(/usr/bin/jq --arg user "$target_user" --arg mode "$grant_mode" '
    [
      .User_Specs[]?
      | select(.User_List == [{"username": $user}])
      | select(.Host_List == [{"hostname": "ALL"}])
      | .Cmnd_Specs[]?
      | select((.runasusers // []) == [{"username": "ALL"}])
      | select(if $mode == "omarchy-wheel" then
                 (.runasgroups // []) == [{"usergroup": "ALL"}]
               else ((.runasgroups // []) | length) == 0 end)
      | select(.Commands == [{"command": "ALL"}])
    ] | length
  ' "$destination/sudo-policy.enabled.json")
  [[ $managed_count == 1 ]] || fail "the effective sudo policy does not contain exactly one managed general grant"

  general_count=$(/usr/bin/jq --arg user "$target_user" '
    [
      .User_Specs[]?
      | select(.User_List != [
          {"usergroup": "wheel"},
          {"username": $user, "negated": true}
        ])
      | .Cmnd_Specs[]?.Commands[]?
      | select(.command == "ALL")
    ] | length
  ' "$destination/sudo-policy.enabled.json")
  [[ $general_count == 1 ]] ||
    fail "another matching sudo rule grants or manipulates ALL; refusing an incomplete Secure Mode"

  while IFS= read -r command; do
    [[ $command != ALL ]] || continue
    executable=${command%% *}
    [[ $executable == /* ]] || fail "retained sudo command is not an absolute path: $command"
    if [[ $executable == *'*'* || $executable == *'?'* || $executable == *'['* ]]; then
      fail "retained sudo command uses a wildcard executable: $command"
    fi
    basename=${executable##*/}
    case "$basename" in
      sh|bash|dash|zsh|fish|env|python*|perl*|ruby*|node*|\
      vi|vim|nvim|less|more|man|sudo|sudoedit|su|doas|\
      tee|cp|mv|install|chmod|chown|mount|nsenter|unshare|\
      docker|podman|pacman|make|gcc|cc|clang|gdb|find|tar|rsync)
        fail "retained sudo command is general-purpose or shell-escapable: $command"
        ;;
    esac
    if [[ $command == "$executable" ]]; then
      delegation_kind="any arguments"
    elif [[ $command == *'*'* || $command == *'?'* || $command == *'['* ]]; then
      delegation_kind="argument pattern"
    else
      delegation_kind="exact arguments"
    fi
    printf 'Retained sudo delegation (%s): %s\n' "$delegation_kind" "$command"
  done < <(/usr/bin/jq -r '.User_Specs[]?.Cmnd_Specs[]?.Commands[]?.command' \
    "$destination/sudo-policy.enabled.json")

  /usr/bin/jq -S --arg user "$target_user" --arg mode "$grant_mode" '
    def controlled:
      ((.runasusers // []) == [{"username": "ALL"}]) and
      (if $mode == "omarchy-wheel" then
         (.runasgroups // []) == [{"usergroup": "ALL"}]
       else ((.runasgroups // []) | length) == 0 end) and
      (.Commands == [{"command": "ALL"}]);
    .User_Specs |= map(
      if (.User_List == [{"username": $user}]) and
         (.Host_List == [{"hostname": "ALL"}]) then
        .Cmnd_Specs |= map(select(controlled | not))
      else . end
    )
    | .User_Specs |= map(select((.Cmnd_Specs | length) > 0))
  ' "$destination/sudo-policy.enabled.json" > "$destination/sudo-policy.disabled.json"
  /usr/bin/rm -f -- "$destination/sudo-policy.current.json"
  /usr/bin/chown root:root "$destination"/sudo-policy.*.json
  /usr/bin/chmod 0600 "$destination"/sudo-policy.*.json
}

preflight() {
  local work=$1

  command -v /usr/bin/cvtsudoers >/dev/null || fail "cvtsudoers is required"
  command -v /usr/bin/jq >/dev/null || fail "jq is required"
  command -v /usr/bin/pkcheck >/dev/null || fail "pkcheck is required"
  command -v /usr/bin/pkaction >/dev/null || fail "pkaction is required"
  command -v /usr/bin/visudo >/dev/null || fail "visudo is required"
  check_sudo_policy_backend
  select_grant_mode
  render_sudo_templates "$work"
  /usr/bin/visudo -cf "$work/sudoers.template" >/dev/null ||
    fail "the prospective managed grant fails visudo validation"
  if [[ $grant_mode == omarchy-wheel ]]; then
    /usr/bin/visudo -cf "$work/omarchy-wheel.managed" >/dev/null ||
      fail "the prospective Omarchy wheel grant fails visudo validation"
  fi
  /usr/bin/visudo -c >/dev/null || fail "the complete sudoers policy is invalid"
  check_rule_precedence
  render_templates "$work"
  create_policy_snapshots "$work"
}

backup_system_files() {
  local destination=$1 path

  /usr/bin/install -d -o root -g root -m 0700 "$destination"
  for path in "${transaction_paths[@]}"; do
    if [[ -f $path && ! -L $path ]]; then
      /usr/bin/cp -a --parents -- "$path" "$destination"
    elif [[ -e $path || -L $path ]]; then
      fail "refusing unsafe existing system path: $path"
    fi
  done
}

restore_system_files() {
  local source=$1 path saved

  for path in "${transaction_paths[@]}"; do
    /usr/bin/rm -f -- "$path"
    saved="$source$path"
    if [[ -f $saved && ! -L $saved ]]; then
      /usr/bin/cp -a -- "$saved" "$path"
    fi
  done
}

restore_previous_install() {
  local backup_dir=$1

  set +e
  echo "Installation failed; restoring the previous EscaLock recovery path." >&2
  restore_system_files "$backup_dir/system"
  if [[ -e $config_dir || -L $config_dir ]]; then
    if [[ -d $config_dir && ! -L $config_dir ]]; then
      /usr/bin/rm -rf -- "$config_dir"
    else
      echo "Could not remove unsafe partial configuration path: $config_dir" >&2
    fi
  fi
  if [[ -d $backup_dir/config.before && ! -L $backup_dir/config.before ]]; then
    /usr/bin/cp -a -- "$backup_dir/config.before" "$config_dir"
  fi
  /usr/bin/visudo -c >/dev/null ||
    echo "WARNING: sudoers validation failed after rollback; use backup $backup_dir" >&2
}

restore_removed_install() {
  local backup_dir=$1

  set +e
  echo "Uninstall failed; restoring the EscaLock recovery path." >&2
  restore_system_files "$backup_dir/system"
  if [[ -e $config_dir || -L $config_dir ]]; then
    if [[ -d $config_dir && ! -L $config_dir ]]; then
      /usr/bin/rm -rf -- "$config_dir"
    else
      echo "Could not remove unsafe partial configuration path: $config_dir" >&2
    fi
  fi
  if [[ ! -e $config_dir && ! -L $config_dir ]] &&
    [[ -d $backup_dir/config && ! -L $backup_dir/config ]]; then
    /usr/bin/cp -a -- "$backup_dir/config" "$config_dir"
  fi
  /usr/bin/visudo -c >/dev/null ||
    echo "WARNING: sudoers validation failed after rollback; use backup $backup_dir" >&2
}

if [[ $operation == check || $operation == install ]]; then
  [[ -n $stage && -n $source_commit && -n $payload_digest ]] || usage
  check_stage
  work=$stage/generated
  preflight "$work"
  if [[ $operation == check ]]; then
    echo "Privileged read-only preflight passed for $target_user."
    exit 0
  fi

  if [[ -e $config_dir ]]; then
    [[ -d $config_dir && ! -L $config_dir ]] || fail "existing configuration path is unsafe"
    config_belongs_to_target || fail "existing EscaLock configuration belongs to another account or is invalid"
    [[ -x $helper ]] || fail "existing helper is missing"
    current_state=$(PKEXEC_UID="$target_uid" "$helper" status) || fail "existing helper could not verify state"
    [[ $current_state == enabled ]] || fail "Administrator Mode must be ON before setup or upgrade"
  else
    for path in "${system_paths[@]}"; do
      [[ ! -e $path && ! -L $path ]] || fail "unexpected existing EscaLock system file: $path"
    done
  fi

  timestamp=$(/usr/bin/date -u +%Y%m%dT%H%M%SZ)
  backup_dir="$backup_root/$timestamp-install-$$"
  /usr/bin/install -d -o root -g root -m 0700 "$backup_dir"
  if [[ -d $config_dir && ! -L $config_dir ]]; then
    /usr/bin/cp -a -- "$config_dir" "$backup_dir/config.before"
  fi
  backup_system_files "$backup_dir/system"

  install_committed=false
  rollback_install() {
    local rc=$?

    trap - EXIT
    if (( rc != 0 )) && [[ $install_committed == false ]]; then
      restore_previous_install "$backup_dir"
    fi
    exit "$rc"
  }
  trap rollback_install EXIT

  /usr/bin/install -d -o root -g root -m 0700 "$config_dir"
  /usr/bin/printf 'TARGET_USER=%s\nTARGET_UID=%s\nGRANT_MODE=%s\n' \
    "$target_user" "$target_uid" "$grant_mode" > "$work/config"
  /usr/bin/printf 'VERSION=%s\nSOURCE_COMMIT=%s\nPAYLOAD_SHA256=%s\n' \
    "$(/usr/bin/jq -er '.version' "$stage/manifest.json")" "$source_commit" "$payload_digest" \
    > "$work/install-metadata"
  /usr/bin/install -o root -g root -m 0600 "$work/config" "$config_dir/config"
  /usr/bin/install -o root -g root -m 0600 "$work/install-metadata" "$config_dir/install-metadata"
  /usr/bin/install -o root -g root -m 0440 "$work/sudoers.template" "$config_dir/sudoers.template"
  if [[ $grant_mode == omarchy-wheel ]]; then
    /usr/bin/install -o root -g root -m 0440 "$work/omarchy-wheel.original" \
      "$config_dir/omarchy-wheel.original"
    /usr/bin/install -o root -g root -m 0440 "$work/omarchy-wheel.managed" \
      "$config_dir/omarchy-wheel.managed"
    /usr/bin/install -o root -g root -m 0440 "$work/sudoers.template" "$grant"
    /usr/bin/install -o root -g root -m 0440 "$work/omarchy-wheel.managed" "$wheel_grant"
  else
    /usr/bin/rm -f -- "$config_dir/omarchy-wheel.original" "$config_dir/omarchy-wheel.managed"
  fi
  /usr/bin/visudo -c >/dev/null || fail "sudoers became invalid while preparing the managed grant"
  /usr/bin/install -o root -g root -m 0644 "$work/rule.on" \
    "$config_dir/00-00-omarchy-escalock-on.rules.template"
  /usr/bin/install -o root -g root -m 0644 "$work/rule.off" \
    "$config_dir/00-00-omarchy-escalock-off.rules.template"
  /usr/bin/install -o root -g root -m 0600 "$work/sudo-policy.enabled.json" \
    "$config_dir/sudo-policy.enabled.json"
  /usr/bin/install -o root -g root -m 0600 "$work/sudo-policy.disabled.json" \
    "$config_dir/sudo-policy.disabled.json"
  /usr/bin/install -o root -g root -m 0644 \
    "$stage/polkit/com.github.andrewbacon.omarchy-escalock.policy" \
    "$config_dir/com.github.andrewbacon.omarchy-escalock.policy.template"

  /usr/bin/install -o root -g root -m 0644 \
    "$stage/polkit/com.github.andrewbacon.omarchy-escalock.policy" "$policy_file"
  /usr/bin/install -o root -g root -m 0644 "$work/rule.on" "$rule_file"
  /usr/bin/install -d -o root -g root -m 0755 /usr/local/libexec
  /usr/bin/install -o root -g root -m 04755 "$stage/build/omarchy-escalock-helper" "$helper"
  /usr/bin/install -o root -g root -m 0755 "$stage/bin/omarchy-escalock" "$cli"
  /usr/bin/install -o root -g root -m 0755 "$stage/bin/omarchy-escalock-maintain" "$maintainer"

  /usr/bin/rm -f -- "$legacy_recovery_rule" "$legacy_off_rule" "$legacy_manage_rule" \
    "$config_dir/05-omarchy-escalock-recovery.rules.template" \
    "$config_dir/10-omarchy-escalock-off.rules.template" \
    "$config_dir/20-omarchy-escalock-manage.rules.template"
  /usr/bin/pkaction --action-id com.github.andrewbacon.omarchy-escalock.enable >/dev/null
  /usr/bin/pkaction --action-id com.github.andrewbacon.omarchy-escalock.disable >/dev/null
  installed_state=$(PKEXEC_UID="$target_uid" "$helper" enable) ||
    fail "installed helper could not verify the active ON policy"
  [[ $installed_state == enabled ]] || fail "post-install state is $installed_state, expected enabled"
  /usr/bin/visudo -c >/dev/null || fail "sudoers became invalid during installation"

  install_committed=true
  trap - EXIT

  echo "Installed EscaLock $("$helper" version) for $target_user from commit $source_commit."
  echo "Administrator Mode remains ON. Backup: $backup_dir"
  exit 0
fi

if [[ $operation == uninstall ]]; then
  [[ -z $stage && -z $source_commit && -z $payload_digest ]] || usage
  [[ -d $config_dir && ! -L $config_dir ]] || fail "trusted EscaLock configuration is missing"
  config_belongs_to_target || fail "EscaLock is configured for another account"
  grant_mode=$(config_grant_mode) || fail "EscaLock grant mode is invalid"
  if [[ $grant_mode == omarchy-wheel ]]; then
    expected_rule="$target_user ALL=(ALL:ALL) ALL"
    [[ -f $config_dir/omarchy-wheel.original && ! -L $config_dir/omarchy-wheel.original ]] ||
      fail "protected original Omarchy wheel grant is missing"
    [[ -f $config_dir/omarchy-wheel.managed && ! -L $config_dir/omarchy-wheel.managed ]] ||
      fail "protected managed Omarchy wheel grant is missing"
    /usr/bin/cmp -s -- "$wheel_grant" "$config_dir/omarchy-wheel.managed" ||
      fail "live Omarchy wheel grant differs from the protected template"
  else
    expected_rule="$target_user ALL=(ALL) ALL"
  fi
  [[ -x $helper ]] || fail "installed helper is missing"
  current_state=$(PKEXEC_UID="$target_uid" "$helper" status) || fail "helper could not verify state"
  [[ $current_state == enabled ]] || fail "Administrator Mode must be ON before uninstall"
  grant_is_exact || fail "the restored sudo grant is missing or modified"
  /usr/bin/cmp -s -- "$grant" "$config_dir/sudoers.template" || fail "live grant differs from the protected template"
  /usr/bin/visudo -c >/dev/null || fail "sudoers is invalid before uninstall"

  timestamp=$(/usr/bin/date -u +%Y%m%dT%H%M%SZ)
  backup_dir="$backup_root/$timestamp-uninstall-$$"
  /usr/bin/install -d -o root -g root -m 0700 "$backup_dir"
  /usr/bin/cp -a -- "$config_dir" "$backup_dir/config"
  backup_system_files "$backup_dir/system"

  uninstall_committed=false
  rollback_uninstall() {
    local rc=$?

    trap - EXIT
    if (( rc != 0 )) && [[ $uninstall_committed == false ]]; then
      restore_removed_install "$backup_dir"
    fi
    exit "$rc"
  }
  trap rollback_uninstall EXIT

  if [[ $grant_mode == omarchy-wheel ]]; then
    /usr/bin/install -o root -g root -m 0440 "$config_dir/omarchy-wheel.original" "$wheel_grant"
    /usr/bin/visudo -c >/dev/null || fail "sudoers became invalid while restoring Omarchy's wheel grant"
    /usr/bin/rm -f -- "$grant"
    /usr/bin/visudo -c >/dev/null || fail "sudoers became invalid while removing the managed per-user grant"
  fi

  /usr/bin/rm -f -- "$rule_file" "$legacy_recovery_rule" "$legacy_off_rule" \
    "$legacy_manage_rule" "$policy_file" "$helper" "$cli"
  /usr/bin/rm -rf -- "$config_dir"
  /usr/bin/visudo -c >/dev/null || fail "sudoers became invalid after uninstall"
  if [[ $grant_mode == omarchy-wheel ]]; then
    wheel_grant_is_exact "$expected_wheel_rule" || fail "restored Omarchy wheel grant is invalid"
    [[ ! -e $grant && ! -L $grant ]] || fail "managed per-user grant remains after uninstall"
  else
    [[ -f $grant ]] || fail "restored sudo grant disappeared"
  fi
  /usr/bin/rm -f -- "$maintainer"

  uninstall_committed=true
  trap - EXIT

  echo "Uninstalled EscaLock system components. Administrator access remains ON."
  echo "Recovery backup: $backup_dir"
  exit 0
fi

usage
