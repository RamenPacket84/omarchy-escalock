# shellcheck shell=bash

readonly helper=/usr/local/libexec/omarchy-escalock-helper
readonly legacy_maintainer=/usr/local/libexec/omarchy-escalock-maintain
readonly uninstaller=/usr/local/libexec/omarchy-escalock-maint-uninstall
readonly installed_common=/usr/local/libexec/omarchy-escalock-maint-common
readonly installed_grant=/usr/local/libexec/omarchy-escalock-maint-grant
readonly installed_transaction=/usr/local/libexec/omarchy-escalock-maint-transaction
readonly cli=/usr/local/bin/omarchy-escalock
readonly config_dir=/etc/omarchy-escalock
readonly sudoers_dir=/etc/sudoers.d
readonly sudoers_main=/etc/sudoers
readonly sudo_conf=/etc/sudo.conf
readonly wheel_grant=/etc/sudoers.d/00-omarchy-wheel
readonly policy_file=/usr/share/polkit-1/actions/com.github.andrewbacon.omarchy-escalock.policy
readonly rule_file=/etc/polkit-1/rules.d/00-00-omarchy-escalock.rules
readonly rule_basename=00-00-omarchy-escalock.rules
readonly legacy_recovery_rule=/etc/polkit-1/rules.d/05-omarchy-escalock-recovery.rules
readonly legacy_off_rule=/etc/polkit-1/rules.d/10-omarchy-escalock-off.rules
readonly legacy_manage_rule=/etc/polkit-1/rules.d/20-omarchy-escalock-manage.rules
readonly backup_root=/var/backups/omarchy-escalock

system_paths=(
  "$helper"
  "$legacy_maintainer"
  "$uninstaller"
  "$installed_common"
  "$installed_grant"
  "$installed_transaction"
  "$cli"
  "$policy_file"
  "$rule_file"
  "$legacy_recovery_rule"
  "$legacy_off_rule"
  "$legacy_manage_rule"
)
transaction_paths=("${system_paths[@]}")

target_user=
target_uid=
target_gid=
legacy_grant_basename=
grant_basename=
grant=
grant_mode=dedicated
expected_rule=
expected_wheel_rule='%wheel ALL=(ALL:ALL) ALL'
expected_managed_wheel_rule=
fresh_wheel_migration=false
grant_messages=true

fail() {
  echo "${escalock_program}: $*" >&2
  exit 1
}

initialize_target_account() {
  local requested_user=$1 passwd_entry account

  [[ $requested_user =~ ^[a-z_][a-z0-9_-]*$ ]] || fail "invalid target username"
  passwd_entry=$(/usr/bin/getent passwd "$requested_user") || fail "target account does not exist"
  IFS=: read -r account _ target_uid target_gid _ _ _ <<<"$passwd_entry"
  [[ $account == "$requested_user" && $target_uid =~ ^[0-9]+$ && $target_gid =~ ^[0-9]+$ ]] ||
    fail "target account lookup mismatch"
  (( target_uid >= 1000 && target_uid != 65534 )) || fail "target UID must be a normal local user"

  target_user=$requested_user
  legacy_grant_basename="00_$target_user"
  grant_basename=$legacy_grant_basename
  grant="$sudoers_dir/$grant_basename"
  grant_mode=dedicated
  expected_rule="$target_user ALL=(ALL) ALL"
  expected_managed_wheel_rule="%wheel, !$target_user ALL=(ALL:ALL) ALL"
  fresh_wheel_migration=false
  transaction_paths=("${system_paths[@]}")
}

config_grant_mode() {
  local configured_mode

  configured_mode=$(/usr/bin/sed -n 's/^GRANT_MODE=//p' "$config_dir/config")
  case "$configured_mode" in
    "" | dedicated) echo dedicated ;;
    omarchy-wheel) echo omarchy-wheel ;;
    *) return 1 ;;
  esac
}

valid_grant_basename() {
  local mode=$1 basename=$2

  case "$mode" in
    dedicated) [[ $basename =~ ^[0-9]{2,}_${target_user}$ ]] ;;
    omarchy-wheel) [[ $basename == "$legacy_grant_basename" ]] ;;
    *) return 1 ;;
  esac
}

config_grant_basename() {
  local configured_mode=$1 configured_basename

  configured_basename=$(/usr/bin/sed -n 's/^GRANT_BASENAME=//p' "$config_dir/config")
  [[ -n $configured_basename ]] || configured_basename=$legacy_grant_basename
  valid_grant_basename "$configured_mode" "$configured_basename" || return 1
  echo "$configured_basename"
}

config_belongs_to_target() {
  local configured_mode configured_basename expected current_expected legacy_expected

  [[ -f $config_dir/config && ! -L $config_dir/config ]] || return 1
  [[ $(/usr/bin/stat -c '%u:%g:%a' "$config_dir/config") == 0:0:600 ]] || return 1
  configured_mode=$(config_grant_mode) || return 1
  configured_basename=$(config_grant_basename "$configured_mode") || return 1
  expected=$'TARGET_USER='"$target_user"$'\nTARGET_UID='"$target_uid"$'\nGRANT_MODE='"$configured_mode"$'\nGRANT_BASENAME='"$configured_basename"
  [[ $(<"$config_dir/config") == "$expected" ]] && return 0
  current_expected=$'TARGET_USER='"$target_user"$'\nTARGET_UID='"$target_uid"$'\nGRANT_MODE='"$configured_mode"
  [[ $configured_basename == "$legacy_grant_basename" &&
     $(<"$config_dir/config") == "$current_expected" ]] && return 0
  legacy_expected=$'TARGET_USER='"$target_user"$'\nTARGET_UID='"$target_uid"
  [[ $configured_mode == dedicated && $configured_basename == "$legacy_grant_basename" &&
     $(<"$config_dir/config") == "$legacy_expected" ]]
}

load_config_grant() {
  grant_mode=$(config_grant_mode) || fail "existing EscaLock grant mode is invalid"
  grant_basename=$(config_grant_basename "$grant_mode") ||
    fail "existing EscaLock grant basename is invalid"
  grant="$sudoers_dir/$grant_basename"
}

grant_is_exact() {
  [[ -f $grant && ! -L $grant ]] || return 1
  [[ $(/usr/bin/stat -c '%u:%g:%a' "$grant") == 0:0:440 ]] || return 1
  [[ $(/usr/bin/wc -l < "$grant") == 1 && $(<"$grant") == "$expected_rule" ]]
}

wheel_grant_is_exact() {
  local expected=$1

  [[ -f $wheel_grant && ! -L $wheel_grant ]] || return 1
  [[ $(/usr/bin/stat -c '%u:%g:%a' "$wheel_grant") == 0:0:440 ]] || return 1
  [[ $(/usr/bin/wc -l < "$wheel_grant") == 1 && $(<"$wheel_grant") == "$expected" ]]
}

write_preflight_plan() {
  local destination=$1 enabled_hash disabled_hash

  enabled_hash=$(/usr/bin/sha256sum "$work/sudo-policy.enabled.json")
  enabled_hash=${enabled_hash%% *}
  disabled_hash=$(/usr/bin/sha256sum "$work/sudo-policy.disabled.json")
  disabled_hash=${disabled_hash%% *}

  /usr/bin/printf '%s\n' \
    "TARGET_USER=$target_user" "TARGET_UID=$target_uid" "GRANT_MODE=$grant_mode" \
    "GRANT_BASENAME=$grant_basename" "FRESH_WHEEL_MIGRATION=$fresh_wheel_migration" \
    "ENABLED_POLICY_SHA256=$enabled_hash" "DISABLED_POLICY_SHA256=$disabled_hash" > "$destination"
  /usr/bin/chown root:root "$destination"
  /usr/bin/chmod 0600 "$destination"
}

verify_preflight_plan() {
  local plan=$1 requested_user=$2
  local metadata
  local -a lines
  local plan_user plan_uid plan_mode plan_basename plan_fresh enabled_hash disabled_hash actual_hash
  local snapshot snapshot_dir

  [[ -f $plan && ! -L $plan ]] || fail "privileged preflight plan is missing or unsafe"
  metadata=$(/usr/bin/stat -c '%u:%g:%a' "$plan")
  [[ $metadata == 0:0:600 ]] || fail "privileged preflight plan has unsafe ownership or permissions"
  mapfile -t lines < "$plan"
  (( ${#lines[@]} == 7 )) || fail "privileged preflight plan has an unexpected format"
  [[ ${lines[0]} == TARGET_USER=* && ${lines[1]} == TARGET_UID=* &&
     ${lines[2]} == GRANT_MODE=* && ${lines[3]} == GRANT_BASENAME=* &&
     ${lines[4]} == FRESH_WHEEL_MIGRATION=* &&
     ${lines[5]} == ENABLED_POLICY_SHA256=* &&
     ${lines[6]} == DISABLED_POLICY_SHA256=* ]] ||
    fail "privileged preflight plan has an unexpected format"
  plan_user=${lines[0]#TARGET_USER=}
  plan_uid=${lines[1]#TARGET_UID=}
  plan_mode=${lines[2]#GRANT_MODE=}
  plan_basename=${lines[3]#GRANT_BASENAME=}
  plan_fresh=${lines[4]#FRESH_WHEEL_MIGRATION=}
  enabled_hash=${lines[5]#ENABLED_POLICY_SHA256=}
  disabled_hash=${lines[6]#DISABLED_POLICY_SHA256=}
  [[ $plan_user == "$requested_user" && $plan_uid =~ ^[0-9]+$ ]] ||
    fail "privileged preflight plan identifies another account"
  [[ $plan_mode == dedicated || $plan_mode == omarchy-wheel ]] ||
    fail "privileged preflight plan has an invalid grant mode"
  [[ $plan_fresh == true || $plan_fresh == false ]] ||
    fail "privileged preflight plan has an invalid migration state"
  [[ $enabled_hash =~ ^[0-9a-f]{64}$ && $disabled_hash =~ ^[0-9a-f]{64}$ ]] ||
    fail "privileged preflight plan has an invalid snapshot digest"
  snapshot_dir=${plan%/*}
  for snapshot in sudo-policy.enabled.json sudo-policy.disabled.json; do
    [[ -f $snapshot_dir/$snapshot && ! -L $snapshot_dir/$snapshot ]] ||
      fail "privileged preflight snapshot is missing or unsafe: $snapshot"
    [[ $(/usr/bin/stat -c '%u:%g:%a' "$snapshot_dir/$snapshot") == 0:0:600 ]] ||
      fail "privileged preflight snapshot has unsafe ownership or permissions: $snapshot"
  done
  actual_hash=$(/usr/bin/sha256sum "$snapshot_dir/sudo-policy.enabled.json")
  [[ ${actual_hash%% *} == "$enabled_hash" ]] || fail "enabled sudo policy changed after preflight"
  actual_hash=$(/usr/bin/sha256sum "$snapshot_dir/sudo-policy.disabled.json")
  [[ ${actual_hash%% *} == "$disabled_hash" ]] || fail "disabled sudo policy changed after preflight"

  initialize_target_account "$requested_user"
  grant_messages=false
  select_grant_mode
  [[ $target_uid == "$plan_uid" && $grant_mode == "$plan_mode" &&
     $grant_basename == "$plan_basename" && $fresh_wheel_migration == "$plan_fresh" ]] ||
    fail "sudo grant state changed after privileged preflight"
}
