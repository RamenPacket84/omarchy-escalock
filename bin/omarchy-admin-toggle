#!/bin/bash

set -euo pipefail

readonly helper=/usr/local/libexec/omarchy-admin-toggle-helper
readonly pkexec=/usr/bin/pkexec

usage() {
  echo "Usage: omarchy-admin-toggle {status|enable|disable|toggle}" >&2
  exit 2
}

status() {
  "$helper" status
}

change_state() {
  local operation=$1
  local result
  local rc

  set +e
  result=$("$pkexec" "$helper" "$operation")
  rc=$?
  set -e
  case $rc in
    0)
      printf '%s\n' "$result"
      ;;
    126)
      echo "Authentication was canceled; Administrator Mode was not changed." >&2
      return 126
      ;;
    127)
      echo "Authorization was denied or unavailable; Administrator Mode was not changed." >&2
      return 127
      ;;
    *)
      echo "Administrator Mode $operation failed; inspect the helper error above." >&2
      return "$rc"
      ;;
  esac
}

(( $# == 1 )) || usage
case "$1" in
  status)
    status
    ;;
  enable | disable)
    change_state "$1"
    ;;
  toggle)
    case "$(status)" in
      enabled) change_state disable ;;
      disabled) change_state enable ;;
      *)
        echo "Administrator Mode is inconsistent; refusing to guess a transition." >&2
        exit 1
        ;;
    esac
    ;;
  *)
    usage
    ;;
esac

