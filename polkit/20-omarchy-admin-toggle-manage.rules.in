// ON-state authorization for disabling Administrator Mode.
// The dynamic 10 rule denies this action while OFF before this rule is reached.
polkit.addRule(function(action, subject) {
    if (action.id !== "com.github.andrewbacon.omarchy-admin-toggle.disable")
        return null;

    if (subject.user === "@@TARGET_USER@@" && subject.local && subject.active)
        return polkit.Result.AUTH_SELF;

    return polkit.Result.NO;
});

