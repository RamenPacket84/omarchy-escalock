// Administrator Mode ON. Generated by EscaLock setup.
polkit.addRule(function(action, subject) {
    if (subject.user !== "@@TARGET_USER@@")
        return null;

    if (action.id !== "com.github.andrewbacon.omarchy-escalock.enable" &&
        action.id !== "com.github.andrewbacon.omarchy-escalock.disable")
        return null;

    if (subject.local && subject.active)
        return polkit.Result.AUTH_SELF;

    return polkit.Result.NO;
});
